select 
    call_id,
    agent_name,
    team,
    calls_handled,
    rank() over(order by calls_handled desc) as rank_calls
from call_performance;

select 
    call_id,
    agent_name,
    team,
    calls_handled,
    row_number() over(order by calls_handled desc) as row_num
from call_performance;

select 
    call_id,
    agent_name,
    team,
    calls_handled,
    rank() over(order by calls_handled desc) as rank_val
from call_performance;

select 
    call_id,
    agent_name,
    team,
    calls_handled,
    dense_rank() over(order by calls_handled desc) as dense_rank_val
from call_performance;

select 
    call_id,
    agent_name,
    team,
    calls_handled,
    row_number() over(order by calls_handled desc) as row_num,
    rank() over(order by calls_handled desc) as rank_val,
    dense_rank() over(order by calls_handled desc) as dense_rank_val
from call_performance;

select 
    call_id,
    agent_name,
    team,
    calls_handled,
    rank() over(partition by team order by calls_handled desc) as team_rank
from call_performance;

select 
    call_id,
    agent_name,
    team,
    customer_rating,
    rank() over(order by customer_rating desc) as rating_rank
from call_performance;

select *
from (
    select 
        call_id,
        agent_name,
        team,
        calls_handled,
        row_number() over(partition by team order by calls_handled desc) as team_row_num
    from call_performance
) t
where team_row_num <= 3;

select *
from (
    select 
        agent_name,
        performance_date,
        calls_handled,
        row_number() over(partition by agent_name order by calls_handled desc) as best_day_rank
    from call_performance
) t
where best_day_rank = 1;

select 
    agent_name,
    sum(calls_handled) as total_calls,
    rank() over(order by sum(calls_handled) desc) as agent_rank
from call_performance
group by agent_name;

