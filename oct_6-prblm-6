select 
    call_id,
    agent_name,
    team,
    calls_handled,
    customer_rating,
    performance_date,
    count(*) over() as total_calls
from call_performance;

select 
    call_id,
    agent_name,
    team,
    calls_handled,
    customer_rating,
    performance_date,
    sum(calls_handled) over(partition by team) as team_total_calls
from call_performance;

select 	
	call_id,
    agent_name,
    team,
    calls_handled,
    customer_rating,
    performance_date,
    avg(calls_handled) over(partition by team) as average_calls
from call_performance;

select 	
	call_id,
    agent_name,
    team,
    calls_handled,
    customer_rating,
    performance_date,
    avg(customer_rating) over(partition by team) as average_rating
from call_performance;


select  
    call_id,
    agent_name,
    team,
    calls_handled,
    customer_rating,
    performance_date,
    sum(calls_handled) over(
        partition by agent_name 
        order by performance_date, call_id
    ) as cumulative_calls
from call_performance
order by agent_name, performance_date, call_id;

select  
    call_id,
    agent_name,
    team,
    calls_handled,
    performance_date,
    sum(calls_handled) over(
        partition by team 
        order by performance_date, call_id
    ) as cumulative_team_calls
from call_performance
order by team, performance_date, call_id;

select  
    call_id,
    agent_name,
    team,
    calls_handled,
    performance_date,
    avg(calls_handled) over(partition by team) as team_avg_calls,
    calls_handled - avg(calls_handled) over(partition by team) as diff_from_avg
from call_performance;

select  
    call_id,
    agent_name,
    team,
    calls_handled,
    performance_date,
    lag(calls_handled) over(
        partition by agent_name 
        order by performance_date
    ) as prev_day_calls
from call_performance
order by agent_name, performance_date;

select  
    call_id,
    agent_name,
    team,
    calls_handled,
    performance_date,
    lag(calls_handled) over(
        partition by agent_name 
        order by performance_date
    ) as prev_day_calls,
    calls_handled - lag(calls_handled) over(
        partition by agent_name 
        order by performance_date
    ) as diff_from_prev
from call_performance
order by agent_name, performance_date;

select  
    call_id,
    agent_name,
    team,
    calls_handled,
    performance_date,
    sum(calls_handled) over(partition by agent_name) as total_agent_calls
from call_performance
order by agent_name, performance_date;
